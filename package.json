{
  "name": "tezzjob",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "migrate": "prisma migrate deploy",
    "migrate-dev": "prisma migrate dev --name",
    "dev:client": "vite",
    "dev:server": "nodemon --watch 'server/src/**/*.ts' --ignore 'server/src/**/*.spec.ts' -r dotenv/config -r tsconfig-paths/register --exec 'ts-node --files server/src/index.ts'",
    "dev": "concurrently \"npm run dev:client\" \"npm run dev:server\"",
    "build:client": "vite build",
    "build:server": "tsc --project tsconfig.json",
    "build": "npm run build:client && npm run build:server",
    "start": "node build/server/index.js"
  },
  "prisma": {
    "schema": "./server/src/prisma/schema.prisma"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@vitejs/plugin-react": "^4.3.3",
    "concurrently": "^9.1.0",
    "dotenv": "^10.0.0",
    "eslint": "^9.15.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "eslint-plugin-react": "^7.37.2",
    "globals": "^15.12.0",
    "prettier": "^3.3.3",
    "prisma": "^4.10.1",
    "ts-node": "^10.9.1",
    "tsc-alias": "^1.8.1",
    "tsconfig-paths": "^3.15.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.15.0",
    "vite": "^5.4.11"
  },
  "dependencies": {
    "@emotion/react": "^11.13.5",
    "@emotion/styled": "^11.13.5",
    "@fontsource/poppins": "^5.1.1",
    "@mui/icons-material": "^6.1.8",
    "@mui/material": "^6.1.8",
    "@prisma/client": "^4.10.1",
    "cors": "^2.8.5",
    "express": "^4.21.1",
    "express-async-errors": "^3.1.1",
    "http-status": "1.5.2",
    "nodemon": "^3.1.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-material-ui-carousel": "^3.4.2",
    "react-router-dom": "^7.1.3",
    "winston": "^3.17.0",
    "zod": "^3.20.6"
  }
}
